FROM node:20-slim

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

RUN npm prune --omit=dev --legacy-peer-deps

# HR service entry point — uses compiled ESM output (tsx is a devDependency,
# removed by npm prune --omit=dev; must use compiled JavaScript here)
CMD ["node", "dist/hr/index.js"]
