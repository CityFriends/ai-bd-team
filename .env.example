# ==============================================================================
# AI BD Team — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file — it is in .gitignore.
#
# CREDENTIAL ROTATION REQUIRED:
# The following credentials should be rotated before production deployment:
#   - ANTHROPIC_API_KEY (rotate via console.anthropic.com)
#   - OPENAI_API_KEY (rotate via platform.openai.com)
#   - SLACK_BOT_TOKEN (rotate via api.slack.com/apps)
#   - SLACK_SIGNING_SECRET (rotate via api.slack.com/apps)
#   - SLACK_APP_TOKEN (rotate via api.slack.com/apps)
#   - SUPABASE_SERVICE_KEY (rotate via supabase.com dashboard)
#   - SUPABASE_ANON_KEY (rotate via supabase.com dashboard)
#   - All agent bot/app tokens (*_BOT_TOKEN, *_APP_TOKEN)
#   - NOTION_API_KEY (rotate via notion.so/my-integrations)
#   - GMAIL_CLIENT_SECRET and GMAIL_REFRESH_TOKEN (rotate via Google Cloud Console)
#   - SAM_API_KEY (rotate via sam.gov)
# ==============================================================================

# --- AI System Controls (Milestone 1A) ---
# Global AI kill switch. Set to 'false' to disable ALL inference.
# Database system_controls table must also have ai_enabled=true for AI to work.
AI_SYSTEM_ENABLED=false

# Autonomous AI (scheduled/cron jobs that invoke LLMs)
ENABLE_AUTONOMOUS_AI=false

# Feature flags — all default to false (disabled)
ENABLE_TEAM_FANOUT=false
ENABLE_MEMORY_EXTRACTION=false
ENABLE_FACT_EXTRACTION=false
ENABLE_ONE_VOICE=false
ENABLE_NEWS_REACTIONS=false

# --- Slack Configuration (required) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# --- Supabase Configuration (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Anthropic AI (required) ---
# ROTATION REQUIRED before production deployment
ANTHROPIC_API_KEY=

# --- OpenAI for embeddings (optional) ---
# ROTATION REQUIRED before production deployment
OPENAI_API_KEY=

# --- Government APIs (optional) ---
SAM_API_KEY=

# --- Notion Integration (optional) ---
NOTION_API_KEY=
NOTION_HUB_PAGE_ID=

# --- Gmail Integration (optional) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Agent Bot Tokens (one per agent) ---
# Each agent has its own Slack app with separate bot and app tokens.
# ROTATION REQUIRED for all agent tokens before production deployment.
MAYA_BOT_TOKEN=
MAYA_APP_TOKEN=
DAVID_BOT_TOKEN=
DAVID_APP_TOKEN=
ROSA_BOT_TOKEN=
ROSA_APP_TOKEN=
JAMES_BOT_TOKEN=
JAMES_APP_TOKEN=
PATRICIA_BOT_TOKEN=
PATRICIA_APP_TOKEN=
MARCUS_BOT_TOKEN=
MARCUS_APP_TOKEN=
JODIE_BOT_TOKEN=
JODIE_APP_TOKEN=

# --- Node Environment ---
NODE_ENV=development
